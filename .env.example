# Orca Digital Pod — copy to .env (never commit secrets)
HOST=127.0.0.1
PORT=8877
ORCA_DAEMON_PORT=6768
LLM_PROXY_PORT=4000
SANDBOX_PORT=9090

WORKSPACE_ROOT=./workspace
TICKETS_DIR=./tickets
ATTACHMENTS_DIR=./ticket-attachments

SANDBOX_EXEC_URL=http://127.0.0.1:9090/exec
ORCA_DAEMON_URL=http://127.0.0.1:6768

# Harnesses use dummy token sk-sidecar-local against the local sidecar.
# The sidecar injects the real upstream key below.
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_ENDPOINT=https://openrouter.ai/api/v1
CUSTOM_LLM_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free

ORCA_MOCK_MODE=false
WATCHDOG_INTERVAL_SEC=30
MAX_GAP_ITERATIONS=5
LOG_LEVEL=INFO
DOCKER_SANDBOX=true
DOCKER_IMAGE=orca-pod-sandbox:local
FORCE_ECHO_HARNESS=false
